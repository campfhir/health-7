    },
    "./builders/v2.5.1/*": {
      "require": "./dist/builders/v2.5.1/*.js",
      "import": "./dist/builders/v2.5.1/*.mjs",
      "types": "./dist/builders/v2.5.1/*.d.ts"
    },
    "./utils/dateUtils": {
      "require": "./dist/utils/dateUtils.js",
      "import": "./dist/utils/dateUtils.mjs",
      "types": "./dist/utils/dateUtils.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "barrels": "tsx codegen/generate-barrels.ts",
    "prebuild": "tsx codegen/generate-barrels.ts && node codegen/generate-package-exports.mjs",
    "build": "tsup",
    "watch": "tsup --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "codegen": "tsx codegen/generate.ts",
    "test:positions": "tsx codegen/generate-field-position-tests.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "exports": "node codegen/generate-package-exports.mjs",
    "codegen:check": "pnpm codegen && pnpm barrels && pnpm exports && test -z \"$(git status --porcelain -- src package.json)\""
  },
  "keywords": [
    "hl7",
    "hl7v2",
    "healthcare",
    "message-builder",
    "message-parser",
    "adt",
    "oru",
    "siu",
    "mfn"
  ],
  "author": "Scott Eremia-Roden",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/campfhir/kindling.git",
    "directory": "packages/hl7"
  },
  "bugs": {
